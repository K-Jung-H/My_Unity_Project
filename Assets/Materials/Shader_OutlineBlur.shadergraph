    "m_FunctionBody": "// 1. 텍셀 사이즈 계산 (_ScreenParams 사용)\r\n// _ScreenParams.x는 가로 폭, .y는 세로 높이입니다.\r\nfloat2 texelSize = float2(1.0 / _ScreenParams.x, 1.0 / _ScreenParams.y);\r\n\r\n// 2. 윤곽선 검출 (Edge Detection)\r\n// 마스크 텍스처에서 상하좌우 샘플링\r\nfloat t = SAMPLE_TEXTURE2D(MaskTex, SS, UV + float2(0, texelSize.y)).r;\r\nfloat b = SAMPLE_TEXTURE2D(MaskTex, SS, UV + float2(0, -texelSize.y)).r;\r\nfloat l = SAMPLE_TEXTURE2D(MaskTex, SS, UV + float2(-texelSize.x, 0)).r;\r\nfloat r = SAMPLE_TEXTURE2D(MaskTex, SS, UV + float2(texelSize.x, 0)).r;\r\nfloat centerMask = SAMPLE_TEXTURE2D(MaskTex, SS, UV).r;\r\n\r\n// 변화량 계산 (간이 Sobel)\r\nfloat edge = saturate(abs(t - b) + abs(l - r));\r\n\r\n// 3. 가우시안 블러 (배경 흐림 처리)\r\nfloat3 blurSum = float3(0, 0, 0);\r\nfloat weightSum = 0.0;\r\nint radius = 4; // 블러 범위\r\n\r\nfor(int x = -radius; x <= radius; x++)\r\n{\r\n    for(int y = -radius; y <= radius; y++)\r\n    {\r\n        float2 offset = float2(x, y) * texelSize * BlurSize;\r\n        // 가우시안 가중치 근사\r\n        float weight = exp(-(x*x + y*y) / 8.0); \r\n        \r\n        blurSum += SAMPLE_TEXTURE2D(MainTex, SS, UV + offset).rgb * weight;\r\n        weightSum += weight;\r\n    }\r\n}\r\nfloat3 blurColor = blurSum / weightSum;\r\n\r\n// 4. 합성 (Composite)\r\nfloat3 originalColor = SAMPLE_TEXTURE2D(MainTex, SS, UV).rgb;\r\n\r\n// Mask(centerMask)가 1이면 원본(캐릭터), 0이면 블러(배경) 사용\r\nOutColor = lerp(blurColor, originalColor, centerMask);\r\n\r\n// 윤곽선 값 별도 출력\r\nOutEdge = edge;"
}

